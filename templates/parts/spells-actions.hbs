{{!-- One feature row (actions, bonus actions, reactions, passives). --}}
{{#*inline "aimFeatureRow"}}
  <div class="aim-spell" data-school="feat" data-flip-id="feat-{{id}}" {{#if @root.canEdit}}data-drag-item="true"{{/if}} data-item-id="{{id}}" data-item-uuid="{{uuid}}">
    <span class="aim-sthumb" data-action="openItem" data-item-id="{{id}}"><img src="{{img}}" alt="{{name}}"></span>
    <div class="aim-spell-text" data-action="openItem" data-item-id="{{id}}">
      <div class="aim-spell-l1"><b>{{name}}</b></div>
      <div class="aim-spell-l2">
        {{#if sourceLabel}}<span>{{sourceLabel}}</span>{{/if}}
        {{#if activationLabel}}<span class="tc-pill is-plain">{{activationLabel}}</span>{{/if}}
        {{#if hasUses}}<span class="aim-uses">{{usesDisplay}}</span>{{/if}}
        {{#if hasRecharge}}<span class="tc-chip"><i class="fa-light fa-arrows-rotate"></i>{{rechargeDisplay}}</span>{{/if}}
      </div>
    </div>
    {{#if @root.canEdit}}<button type="button" class="tc-ibtn aim-edit" data-action="useItem" data-item-id="{{id}}" aria-label="{{localize 'AIM.actions.use'}}: {{name}}" data-tooltip="{{localize 'AIM.actions.use'}}"><i class="fa-light fa-dice-d20"></i></button>{{/if}}
  </div>
{{/inline}}

{{#*inline "aimFeatureGroup"}}
  {{#if rows.length}}
    <div class="aim-grp">
      <div class="tc-sec"><span class="tc-lbl"><i class="fa-light {{icon}}"></i> {{title}} <b>{{rows.length}}</b></span></div>
      {{#each rows}}{{> aimFeatureRow}}{{/each}}
    </div>
  {{/if}}
{{/inline}}

<div class="tc-shell aim-drawer-shell"><div class="tc-core">
  <div class="aim-dh">
    <span class="aim-dh-ic"><i class="fa-light fa-wand-magic-sparkles"></i></span>
    <b>{{localize "AIM.spells.drawerTitle"}}</b>
    <button type="button" class="tc-ibtn" data-action="toggleSpellsPanel" aria-label="{{localize 'AIM.actions.close'}}" data-tooltip="{{localize 'AIM.actions.close'}}"><i class="fa-light fa-xmark"></i></button>
  </div>

  <div class="aim-dtools">
    <nav class="tc-segs" aria-label="{{localize 'AIM.spells.drawerTitle'}}">
      {{#each spellsTabs as |tab|}}
        <button type="button" class="tc-seg" data-action="switchSpellsTab" data-tab="{{tab.id}}" aria-pressed="{{#if (eq @root.spellsTab tab.id)}}true{{else}}false{{/if}}"
                aria-label="{{localize (concat 'AIM.spells.tabs.' tab.id)}}" data-tooltip="{{localize (concat 'AIM.spells.tabs.' tab.id)}}">
          <i class="fa-light {{tab.icon}}"></i><span class="tc-seg-label">{{localize (concat "AIM.spells.tabs." tab.id)}}</span><span class="tc-seg-count">{{lookup @root.spellsCounts tab.id}}</span>
        </button>
      {{/each}}
    </nav>
    <label class="tc-search"><i class="fa-light fa-magnifying-glass"></i>
      <input type="text" id="{{appId}}-spells-search" name="aim-spells-search" data-spells-search="true" autocomplete="off" placeholder="{{localize 'AIM.spells.searchPlaceholder'}}" value="{{spellsSearchFilter}}" aria-label="{{localize 'AIM.spells.searchPlaceholder'}}">
    </label>
  </div>

  <div class="aim-dbody aim-scroll aim-spells-scroll-area">
    {{#if showSpells}}
      {{#if spellSlots.length}}
        <div class="aim-slots" aria-label="{{localize 'AIM.spells.spellSlotsTitle'}}">
          {{#each spellSlots as |slot|}}
            <div class="aim-srow" data-slot-key="{{slot.key}}">
              <span class="tc-lbl">{{slot.label}}</span>
              <div class="aim-pips">
                {{#each slot.pips}}
                  {{#if @root.canEdit}}
                    <button type="button" class="tc-pip {{#if this.filled}}is-on{{/if}}" data-action="updateSpellSlot" data-slot-key="{{slot.key}}"
                            data-delta="{{#if this.filled}}-1{{else}}1{{/if}}"
                            data-tooltip="{{#if this.filled}}{{localize 'AIM.spells.spendSlot'}}{{else}}{{localize 'AIM.spells.restoreSlot'}}{{/if}}"
                            aria-label="{{slot.label}}: {{#if this.filled}}{{localize 'AIM.spells.spendSlot'}}{{else}}{{localize 'AIM.spells.restoreSlot'}}{{/if}}"></button>
                  {{else}}
                    <span class="tc-pip {{#if this.filled}}is-on{{/if}}"></span>
                  {{/if}}
                {{/each}}
              </div>
              <span class="aim-srow-count">{{slot.value}} / {{slot.max}}</span>
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#each spellGroups as |group|}}
        <div class="aim-grp">
          <div class="tc-sec"><span class="tc-lbl">{{#if group.isPreparedGroup}}<i class="fa-light fa-book-bookmark"></i> {{/if}}{{group.title}} <b>{{group.count}}</b></span></div>
          {{#each group.spells as |spell|}}
            <div class="aim-spell" data-school="{{spell.school}}" data-flip-id="spell-{{spell.id}}" style="--spell-school-color: {{spell.schoolColor}};"
                 {{#if @root.canEdit}}data-drag-item="true"{{/if}} data-item-id="{{spell.id}}" data-item-uuid="{{spell.uuid}}" data-level="{{spell.level}}">
              <span class="aim-sthumb" data-action="openItem" data-item-id="{{spell.id}}">
                <img src="{{spell.img}}" alt="{{spell.name}}">
                {{#if group.isPreparedGroup}}<span class="aim-sthumb-lv" data-tooltip="{{spell.levelLabel}}">{{spell.level}}</span>{{/if}}
              </span>
              <div class="aim-spell-text">
                <div class="aim-spell-l1">
                  <b data-action="openItem" data-item-id="{{spell.id}}">{{spell.name}}</b>
                  {{#if spell.isAlwaysPrepared}}
                    <span class="aim-prep is-on is-always" data-tooltip="{{localize 'AIM.spells.alwaysPrepared'}}"><i class="fa-light fa-lock"></i></span>
                  {{else if (and spell.canTogglePrep @root.canEdit)}}
                    <button type="button" class="aim-prep {{#if spell.isPrepared}}is-on{{/if}}" data-action="toggleSpellPrep" data-item-id="{{spell.id}}"
                            aria-pressed="{{#if spell.isPrepared}}true{{else}}false{{/if}}"
                            aria-label="{{#if spell.isPrepared}}{{localize 'AIM.spells.prepared'}}{{else}}{{localize 'AIM.spells.unprepared'}}{{/if}}: {{spell.name}}"
                            data-tooltip="{{#if spell.isPrepared}}{{localize 'AIM.spells.prepared'}}{{else}}{{localize 'AIM.spells.unprepared'}}{{/if}}"><i class="{{#if spell.isPrepared}}fa-solid{{else}}fa-light{{/if}} fa-book-bookmark"></i></button>
                  {{else if spell.canTogglePrep}}
                    <span class="aim-prep {{#if spell.isPrepared}}is-on{{/if}}" data-tooltip="{{#if spell.isPrepared}}{{localize 'AIM.spells.prepared'}}{{else}}{{localize 'AIM.spells.unprepared'}}{{/if}}"><i class="{{#if spell.isPrepared}}fa-solid{{else}}fa-light{{/if}} fa-book-bookmark"></i></span>
                  {{/if}}
                </div>
                <div class="aim-spell-l2" data-action="openItem" data-item-id="{{spell.id}}">
                  <span class="aim-school">{{spell.schoolLabel}}</span>
                  {{#if spell.activationLabel}}<span class="tc-pill is-plain">{{spell.activationLabel}}</span>{{/if}}
                  {{#if spell.rangeDisplay}}<span>{{spell.rangeDisplay}}</span>{{/if}}
                  {{#if spell.components.v}}<span class="tc-chip" data-tooltip="{{localize 'AIM.spells.components.vocal'}}">{{localize "AIM.spells.components.vocalAbbr"}}</span>{{/if}}
                  {{#if spell.components.s}}<span class="tc-chip" data-tooltip="{{localize 'AIM.spells.components.somatic'}}">{{localize "AIM.spells.components.somaticAbbr"}}</span>{{/if}}
                  {{#if spell.components.m}}<span class="tc-chip" data-tooltip="{{localize 'AIM.spells.components.material'}}">{{localize "AIM.spells.components.materialAbbr"}}</span>{{/if}}
                  {{#if spell.components.concentration}}<span class="tc-chip" data-tooltip="{{localize 'AIM.spells.components.concentration'}}"><i class="fa-light fa-brain"></i></span>{{/if}}
                  {{#if spell.components.ritual}}<span class="tc-chip" data-tooltip="{{localize 'AIM.spells.components.ritual'}}"><i class="fa-light fa-scroll"></i></span>{{/if}}
                </div>
              </div>
              {{#if @root.canEdit}}<button type="button" class="tc-ibtn aim-edit" data-action="useItem" data-item-id="{{spell.id}}" aria-label="{{localize 'AIM.spells.cast'}}: {{spell.name}}" data-tooltip="{{localize 'AIM.spells.cast'}}"><i class="fa-light fa-wand-magic-sparkles"></i></button>{{/if}}
            </div>
          {{/each}}
        </div>
      {{/each}}
    {{/if}}

    {{#if showActions}}
      {{> aimFeatureGroup rows=actionsData.actions icon="fa-bolt" title=(localize "AIM.spells.actionTypes.action")}}
      {{> aimFeatureGroup rows=actionsData.bonus icon="fa-forward" title=(localize "AIM.spells.actionTypes.bonus")}}
      {{> aimFeatureGroup rows=actionsData.reactions icon="fa-reply" title=(localize "AIM.spells.actionTypes.reaction")}}
    {{/if}}

    {{#if showPassives}}
      {{> aimFeatureGroup rows=actionsData.passives icon="fa-shield-heart" title=(localize "AIM.spells.actionTypes.passive")}}
    {{/if}}

    {{#unless (lookup spellsCounts spellsTab)}}<div class="aim-empty"><i class="fa-light fa-book-sparkles"></i>{{#if spellsSearchFilter}}{{localize "AIM.items.noMatches"}}{{else}}{{localize "AIM.spells.noSpellsFound"}}{{/if}}</div>{{/unless}}
  </div>
</div></div>
