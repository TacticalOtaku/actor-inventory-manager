<div class="tc-shell aim-drawer-shell"><div class="tc-core">
  <div class="aim-dh">
    <span class="aim-dh-ic"><i class="fa-light fa-handshake"></i></span>
    <b>{{localize "AIM.trade.title"}}</b>
    <button type="button" class="tc-ibtn" data-action="toggleTradePanel" aria-label="{{localize 'AIM.trade.close'}}" data-tooltip="{{localize 'AIM.trade.close'}}"><i class="fa-light fa-xmark"></i></button>
  </div>

  <div class="aim-dbody aim-scroll aim-trade-scroll-area">
    <div class="aim-tmeta"><span>{{trade.provider}}</span><b role="status">{{trade.status}}</b></div>
    {{#unless trade.hasGM}}<div class="aim-unsaved" role="alert"><i class="fa-light fa-triangle-exclamation"></i><span>{{localize "AIM.trade.errors.noGM"}}</span></div>{{/unless}}
    {{#if trade.error}}<div class="aim-unsaved" role="alert"><i class="fa-light fa-triangle-exclamation"></i><span>{{trade.error}}</span></div>{{/if}}

    {{#if trade.session}}
      <div class="aim-partner"><i class="fa-light fa-user"></i><span>{{localize "AIM.trade.with"}} <b>{{trade.partner}}</b></span></div>
      <div class="aim-conf" aria-live="polite">
        <span class="aim-cf {{#if trade.mineConfirmed}}is-ok{{/if}}"><i class="fa-light {{#if trade.mineConfirmed}}fa-check{{else}}fa-hourglass-half{{/if}}"></i>{{localize "AIM.trade.you"}}</span>
        <span class="aim-cf {{#if trade.theirsConfirmed}}is-ok{{/if}}"><i class="fa-light {{#if trade.theirsConfirmed}}fa-check{{else}}fa-hourglass-half{{/if}}"></i><span class="aim-cf-name">{{trade.partner}}</span></span>
      </div>

      <div>
        <div class="tc-sec"><span class="tc-lbl">{{localize "AIM.trade.theirOffer"}}</span></div>
        <ul class="aim-offer">
          {{#each trade.otherItems}}<li><span>{{name}}</span><b>×{{quantity}}</b></li>{{/each}}
          {{#each trade.otherMoney}}<li><span>{{label}}</span><b>{{amount}}</b></li>{{/each}}
        </ul>
      </div>
      <div>
        <div class="tc-sec"><span class="tc-lbl">{{localize "AIM.trade.yourOffer"}}</span></div>
        <ul class="aim-offer">
          {{#each trade.myItems}}<li><span>{{name}}</span><b>×{{quantity}}</b></li>{{/each}}
          {{#each trade.myMoney}}<li><span>{{label}}</span><b>{{amount}}</b></li>{{/each}}
        </ul>
      </div>

      {{#if trade.participant}}
        <p class="aim-thint">{{localize "AIM.trade.editHint"}}</p>
        <fieldset class="aim-tfields" {{#unless trade.canEdit}}disabled{{/unless}}>
          <legend class="aim-sr">{{localize "AIM.trade.yourOffer"}}</legend>
          <div class="tc-sec"><span class="tc-lbl">{{localize "AIM.trade.currencies"}}</span></div>
          <div class="aim-money">
            {{#each trade.money}}
              <label><span>{{label}} <small>{{quantity}}</small></span><input type="number" min="0" step="{{step}}" value="{{amount}}" data-trade-money="{{key}}" aria-label="{{label}}"></label>
            {{/each}}
          </div>
          <div class="tc-sec"><span class="tc-lbl">{{localize "AIM.trade.items"}}</span></div>
          {{#each trade.items}}
            <label class="aim-titem">
              <span class="aim-thumb is-tiny"><img src="{{img}}" alt="" loading="lazy"></span>
              <span class="aim-titem-name"><b>{{name}}</b><small>{{localize "AIM.trade.available"}}: {{available}}</small></span>
              <input class="aim-qty" type="number" min="0" max="{{available}}" step="1" value="{{quantity}}" data-trade-item="{{id}}" aria-label="{{name}}">
            </label>
          {{else}}
            <p class="aim-thint">{{localize "AIM.trade.noItems"}}</p>
          {{/each}}
        </fieldset>
        <div class="aim-unsaved" data-trade-unsaved {{#unless trade.dirty}}hidden{{/unless}}><i class="fa-light fa-triangle-exclamation"></i><span>{{localize "AIM.trade.unsaved"}}</span></div>
      {{/if}}
      {{#if trade.recovery}}<button type="button" class="tc-btn" data-action="tradeAction" data-trade-op="recover" {{#if trade.busy}}disabled{{/if}}><i class="fa-light fa-life-ring"></i>{{localize "AIM.trade.recover"}}</button>{{/if}}
    {{else}}
      <p class="aim-thint">{{localize "AIM.trade.intro"}}</p>
      {{#if trade.noTargets}}
        <p class="aim-thint">{{localize "AIM.trade.noTargets"}}</p>
      {{else}}
        <label class="aim-ttarget"><span class="tc-lbl">{{localize "AIM.trade.partner"}}</span>
          <select class="tc-select" data-trade-target {{#unless trade.canStart}}disabled{{/unless}}>
            {{#each trade.targets}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <button type="button" class="tc-primary" data-action="tradeAction" data-trade-op="start" {{#unless trade.canStart}}disabled{{/unless}} {{#if trade.busy}}disabled{{/if}}>
          <span>{{localize "AIM.trade.start"}}</span><span class="tc-primary-nest"><i class="fa-light fa-handshake"></i></span>
        </button>
      {{/if}}
    {{/if}}
  </div>

  {{#if trade.participant}}
    <div class="aim-dfoot">
      <button type="button" class="tc-btn is-square" data-action="tradeAction" data-trade-op="cancel" aria-label="{{localize 'AIM.trade.cancel'}}" data-tooltip="{{localize 'AIM.trade.cancel'}}" {{#if trade.locked}}disabled{{/if}} {{#if trade.busy}}disabled{{/if}}><i class="fa-light fa-xmark"></i></button>
      <button type="button" class="tc-btn" data-action="tradeAction" data-trade-op="offer" {{#unless trade.canSave}}disabled{{/unless}}><i class="fa-light fa-floppy-disk"></i>{{localize "AIM.trade.save"}}</button>
      <button type="button" class="tc-primary" data-action="tradeAction" data-trade-op="confirm" {{#unless trade.canConfirm}}disabled{{/unless}}>
        <span>{{localize "AIM.trade.confirm"}}</span><span class="tc-primary-nest"><i class="fa-light fa-check"></i></span>
      </button>
    </div>
  {{/if}}
</div></div>
