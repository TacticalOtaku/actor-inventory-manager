<div class="aim-featurebook">
  <div class="aim-toolbar">
    <label class="aim-search"><i class="fa-light fa-magnifying-glass"></i><input type="search" name="featureSearch" value="{{features.query}}" placeholder="{{localize "AIM.window.features.search"}}" autocomplete="off" spellcheck="false" aria-label="{{localize "AIM.window.features.search"}}"></label>
    <div class="aim-seg" role="group" aria-label="{{localize "AIM.window.inv.view"}}">
      {{#each features.views}}<button type="button" data-action="listView" data-tab="features" data-view="{{id}}" aria-pressed="{{active}}" aria-label="{{label}}" data-tooltip="{{label}}"><i class="fa-light {{icon}}"></i></button>{{/each}}
    </div>
  </div>
  <div class="aim-filters aim-spell-filters">
    {{#each features.filters}}<button type="button" class="aim-chip {{#if on}}is-on{{/if}}" data-action="listFilter" data-tab="features" data-filter="{{id}}" aria-pressed="{{on}}">{{label}}</button>{{/each}}
  </div>
  {{#each features.groups}}
  <section class="aim-section {{#if collapsed}}is-collapsed{{/if}}" data-section="{{id}}" data-key="sec-{{id}}">
    <div class="aim-sec-head" data-action="toggleSection" data-section-id="{{id}}" role="button" tabindex="0" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">
      <i class="fa-light fa-chevron-down aim-chev"></i>
      {{#if classLink}}<h3><button type="button" class="aim-link" data-action="openDocument" data-id="{{classLink}}">{{label}}</button></h3>{{else}}<h3>{{label}}</h3>{{/if}}
      <span class="aim-sec-n">{{entries.length}}</span>
      <span class="aim-sec-meta">{{meta}}{{#each links}}{{#if @first}}{{#if ../meta}} · {{/if}}{{else}} · {{/if}}<button type="button" class="aim-link" data-action="openDocument" data-id="{{id}}">{{label}}</button>{{/each}}</span>
      {{#if @root.canEdit}}<button type="button" class="aim-ibtn aim-mini aim-sec-add" data-action="addFeature" aria-label="{{@root.features.addLabel}}" data-tooltip="{{@root.features.addLabel}}"><i class="fa-light fa-plus"></i></button>{{/if}}
    </div>
    <div class="aim-sec-body"><div class="aim-sec-inner">
      {{#if entries.length}}
      <div class="aim-items" data-view="{{@root.features.prefs.view}}">{{#each entries}}{{> "modules/actor-inventory-manager/templates/window/feature-row.hbs"}}{{/each}}</div>
      {{else}}<p class="aim-sec-empty">{{@root.features.emptyText}}</p>{{/if}}
    </div></div>
  </section>
  {{else}}
  <p class="aim-empty">{{features.noneText}}</p>
  {{/each}}
</div>
